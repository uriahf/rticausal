[{"path":"https://uriahf.github.io/rticausal/articles/ipeval-calibration-comparison.html","id":"example-data-and-prediction-models","dir":"Articles","previous_headings":"","what":"Example data and prediction models","title":"Calibration under interventions: rticausal and ipeval","text":"","code":"library(ipeval) library(rticausal)  simulate_data <- function(n, seed) {   set.seed(seed)   data <- data.frame(id = seq_len(n))   data$L <- rnorm(n)   data$A <- rbinom(n, 1, plogis(2 * data$L))   data$P <- rnorm(n)   data$Y <- rbinom(     n,     1,     plogis(0.5 + data$L + 1.25 * data$P - 0.9 * data$A)   )   data }  df_dev <- simulate_data(n = 5000, seed = 1) df_val <- simulate_data(n = 10000, seed = 2)  model_naive <- glm(Y ~ A + P, family = \"binomial\", data = df_dev)  trt_model_dev <- glm(A ~ L, family = \"binomial\", data = df_dev) propensity_dev <- predict(trt_model_dev, type = \"response\") iptw_dev <- 1 / ifelse(df_dev$A == 1, propensity_dev, 1 - propensity_dev) model_causal <- glm(   Y ~ A + P,   family = \"binomial\",   data = df_dev,   weights = iptw_dev ) #> Warning in eval(family$initialize): non-integer #successes in a binomial glm!  # ipeval estimates validation-set treatment weights from A ~ L internally. # rticausal consumes caller-supplied weights, so fit the same treatment model # explicitly for the comparison below. trt_model_val <- glm(A ~ L, family = \"binomial\", data = df_val) propensity_val <- predict(trt_model_val, type = \"response\")  # Match the colors used by ipeval::plot.ip_score(). ipeval_colors <- grDevices::adjustcolor(   rep(grDevices::palette()[-1], length.out = 2),   alpha.f = 0.8 )"},{"path":"https://uriahf.github.io/rticausal/articles/ipeval-calibration-comparison.html","id":"if-nobody-were-treated-a-0","dir":"Articles","previous_headings":"","what":"If nobody were treated: A = 0","title":"Calibration under interventions: rticausal and ipeval","text":"rticausal, predictions generated every validation subject setting treatment 0. weights subjects actually untreated inverse probabilities receiving treatment.","code":"pred_0 <- list(   \"naive\" = predict(     model_naive,     newdata = transform(df_val, A = 0),     type = \"response\"   ),   \"causal\" = predict(     model_causal,     newdata = transform(df_val, A = 0),     type = \"response\"   ) ) weights_0 <- 1 / (1 - propensity_val)  score_0 <- ip_score(   object = list(     \"naive\" = model_naive,     \"causal\" = model_causal   ),   data = df_val,   outcome = Y,   treatment_formula = A ~ L,   treatment_of_interest = 0,   metrics = \"calplot\",   null_model = FALSE,   quiet = TRUE )"},{"path":"https://uriahf.github.io/rticausal/articles/ipeval-calibration-comparison.html","id":"comparison","dir":"Articles","previous_headings":"If nobody were treated: A = 0","what":"Comparison","title":"Calibration under interventions: rticausal and ipeval","text":"ipeval rticausal","code":"plot(score_0, main = \"Calibration if everyone had A = 0\") create_calibration_curve(   probs = pred_0,   reals = df_val$Y,   treats = df_val$A,   intervention = 0,   weights = weights_0,   n_bins = 8,   size = 500,   color_values = ipeval_colors )"},{"path":"https://uriahf.github.io/rticausal/articles/ipeval-calibration-comparison.html","id":"if-everybody-were-treated-a-1","dir":"Articles","previous_headings":"","what":"If everybody were treated: A = 1","title":"Calibration under interventions: rticausal and ipeval","text":"","code":"pred_1 <- list(   \"naive\" = predict(     model_naive,     newdata = transform(df_val, A = 1),     type = \"response\"   ),   \"causal\" = predict(     model_causal,     newdata = transform(df_val, A = 1),     type = \"response\"   ) ) weights_1 <- 1 / propensity_val  score_1 <- ip_score(   object = list(     \"naive\" = model_naive,     \"causal\" = model_causal   ),   data = df_val,   outcome = Y,   treatment_formula = A ~ L,   treatment_of_interest = 1,   metrics = \"calplot\",   null_model = FALSE,   quiet = TRUE )"},{"path":"https://uriahf.github.io/rticausal/articles/ipeval-calibration-comparison.html","id":"comparison-1","dir":"Articles","previous_headings":"If everybody were treated: A = 1","what":"Comparison","title":"Calibration under interventions: rticausal and ipeval","text":"ipeval rticausal  two packages use eight rank-based calibration bins comparison. rticausal keeps established rtichoke presentation, including prediction histogram, intervention-specific calibration coordinates follow ipeval calculation.","code":"plot(score_1, main = \"Calibration if everyone had A = 1\") create_calibration_curve(   probs = pred_1,   reals = df_val$Y,   treats = df_val$A,   intervention = 1,   weights = weights_1,   n_bins = 8,   size = 500,   color_values = ipeval_colors )"},{"path":"https://uriahf.github.io/rticausal/authors.html","id":null,"dir":"","previous_headings":"","what":"Authors","title":"Authors and Citation","text":"Uriah Finkel. Maintainer, author.","code":""},{"path":"https://uriahf.github.io/rticausal/authors.html","id":"citation","dir":"","previous_headings":"","what":"Citation","title":"Authors and Citation","text":"Finkel U (2026). rticausal: Evaluation Predictions Interventions. R package version 0.0.1, https://uriahf.github.io/rticausal/.","code":"@Manual{,   title = {rticausal: Evaluation of Predictions Under Interventions},   author = {Uriah Finkel},   year = {2026},   note = {R package version 0.0.1},   url = {https://uriahf.github.io/rticausal/}, }"},{"path":"https://uriahf.github.io/rticausal/index.html","id":"rticausal","dir":"","previous_headings":"","what":"Evaluation of Predictions Under Interventions","title":"Evaluation of Predictions Under Interventions","text":"External validation evaluation predictions interventions R. Initial public API: factual calibration, rticausal delegates directly rtichoke. intervention-specific calibration, probs contains one model/prediction series intervention, treats contains observed treatment assignments, intervention identifies treatment level evaluated, weights optionally supplies identification/design weights. rticausal fit propensity models. intervention calibration coordinates follow ipeval calibration semantics: predictions sorted divided 8 rank groups default (fewer fewer unique prediction values); plotted predicted value unweighted mean prediction among subjects group, observed value weighted mean outcome among subjects observed intervention interest. different group count can supplied groups. initial scope static binary discrete calibration. create_summary_report() contains calibration . Existing rtichoke rendering machinery reused calibration coordinates prepared.","code":"create_calibration_curve() create_summary_report()"},{"path":"https://uriahf.github.io/rticausal/reference/create_calibration_curve.html","id":null,"dir":"Reference","previous_headings":"","what":"Create a calibration curve — create_calibration_curve","title":"Create a calibration curve — create_calibration_curve","text":"Creates ordinary factual calibration treats NULL, delegating directly rtichoke::create_calibration_curve(). predictions intervention, treats contains observed treatment assignments intervention identifies treatment level whose predicted risks probs.","code":""},{"path":"https://uriahf.github.io/rticausal/reference/create_calibration_curve.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Create a calibration curve — create_calibration_curve","text":"","code":"create_calibration_curve(   probs,   reals,   treats = NULL,   intervention = NULL,   weights = NULL,   n_bins = 10L,   interactive = TRUE,   type = \"discrete\",   ... )"},{"path":"https://uriahf.github.io/rticausal/reference/create_calibration_curve.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Create a calibration curve — create_calibration_curve","text":"probs Named list predicted probabilities. Names identify models prediction series. intervention mode every series must predict risk intervention. reals Binary observed outcomes. treats Optional observed treatment assignments. intervention Optional treatment level whose counterfactual predictions evaluated. Required treats supplied. weights Optional non-negative observation weights. Used intervention mode. omitted, observations assigned intervention receive weight 1. n_bins Number rank-based calibration bins intervention mode. Defaults 10 match rtichoke's discrete calibration behavior. different value, 8 ipeval parity, can requested explicitly. actual number capped number unique predictions series. interactive Passed rtichoke's calibration renderer. type Calibration type. Intervention calibration currently supports \"discrete\". ... Additional arguments passed rtichoke calibration preparation.","code":""},{"path":"https://uriahf.github.io/rticausal/reference/create_calibration_curve.html","id":"value","dir":"Reference","previous_headings":"","what":"Value","title":"Create a calibration curve — create_calibration_curve","text":"calibration plot produced rtichoke.","code":""},{"path":"https://uriahf.github.io/rticausal/reference/create_calibration_curve.html","id":"details","dir":"Reference","previous_headings":"","what":"Details","title":"Create a calibration curve — create_calibration_curve","text":"Intervention calibration reproduces subgroup coordinates used ipeval::ip_score(..., metrics = \"calplot\"): predictions sorted split equally sized rank bins using cut(seq_len(n), breaks = n_bins); x unweighted mean prediction among subjects bin, y weighted mean outcome among subjects observed intervention.","code":""},{"path":"https://uriahf.github.io/rticausal/reference/create_calibration_curve.html","id":"ref-examples","dir":"Reference","previous_headings":"","what":"Examples","title":"Create a calibration curve — create_calibration_curve","text":"","code":"set.seed(1) n <- 1000  data <- data.frame(L = rnorm(n), P = rnorm(n)) data$A <- rbinom(n, 1, plogis(data$L)) data$Y <- rbinom(n, 1, plogis(0.1 + 0.5 * data$L + 0.7 * data$P - 2 * data$A))  # Predict each subject's risk if treatment were set to A = 0. outcome_model <- glm(Y ~ A + P, data = data, family = \"binomial\") intervention_data <- transform(data, A = 0) probs <- predict(outcome_model, newdata = intervention_data, type = \"response\")  # Supply inverse-probability weights; rticausal does not estimate them. treatment_model <- glm(A ~ L, data = data, family = \"binomial\") propensity <- predict(treatment_model, type = \"response\") weights <- 1 / (1 - propensity)  create_calibration_curve(   probs = list(\"Model\" = probs),   reals = data$Y,   treats = data$A,   intervention = 0,   weights = weights )  {\"x\":{\"data\":[{\"x\":[0,0.01,0.02,0.029999999999999999,0.040000000000000001,0.050000000000000003,0.059999999999999998,0.070000000000000007,0.080000000000000002,0.089999999999999997,0.10000000000000001,0.11,0.12,0.13,0.14000000000000001,0.14999999999999999,0.16,0.17000000000000001,0.17999999999999999,0.19,0.20000000000000001,0.20999999999999999,0.22,0.23000000000000001,0.23999999999999999,0.25,0.26000000000000001,0.27000000000000002,0.28000000000000003,0.28999999999999998,0.29999999999999999,0.31,0.32000000000000001,0.33000000000000002,0.34000000000000002,0.35000000000000003,0.35999999999999999,0.37,0.38,0.39000000000000001,0.40000000000000002,0.41000000000000003,0.41999999999999998,0.42999999999999999,0.44,0.45000000000000001,0.46000000000000002,0.47000000000000003,0.47999999999999998,0.48999999999999999,0.5,0.51000000000000001,0.52000000000000002,0.53000000000000003,0.54000000000000004,0.55000000000000004,0.56000000000000005,0.57000000000000006,0.57999999999999996,0.58999999999999997,0.59999999999999998,0.60999999999999999,0.62,0.63,0.64000000000000001,0.65000000000000002,0.66000000000000003,0.67000000000000004,0.68000000000000005,0.69000000000000006,0.70000000000000007,0.70999999999999996,0.71999999999999997,0.72999999999999998,0.73999999999999999,0.75,0.76000000000000001,0.77